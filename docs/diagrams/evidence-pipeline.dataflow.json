  "cards": [
    {
      "dot": "cyan",
      "title": "Two records, one truth",
      "items": [
        "PostgreSQL holds current transactional truth, isolated per tenant",
        "The append-only ledger holds immutable proof of how it got there",
        "Neither is derived from the other; both come from the same authorized action"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence is produced, not written later",
      "items": [
        "A candidate carries its own evidence from extraction onward",
        "The receipt is signed at commit time, never reconstructed afterwards",
        "Scope is structural: company, RUC and period are part of every read"
      ]
    },
    {
      "dot": "rose",
      "title": "Verification has a separate owner",
      "items": [
        "Guardian Angel reads frozen bytes and can only advise or challenge",
        "It cannot rewrite the ledger or the database",
        "Disagreement is a recorded finding that a human resolves"
      ]
    },
    {
      "dot": "violet",
      "title": "Memory informs, it never authorizes",
      "items": [
        "Drenyra Engram stores durable institutional history and provenance",
        "The Command Center reads that context when an operator asks for it",
        "It can never approve, commit or override a fiscal action"
      ]
    }
  ]
}
